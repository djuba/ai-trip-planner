        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^Bearer \\S+$"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/v1/trip/recommend"
      },
      "response": {
        "body": {
          "content": {
            "critique": {
              "pass": true,
              "unresolved": [
                {
                  "issue": "A claim is unsupported.",
                  "recommendationId": "rec-1"
                }
              ]
            },
            "recommendations": [
              {
                "claims": [
                  {
                    "kind": "flight",
                    "statement": "Flights from Minneapolis may be available with one stop.",
                    "verification": "unverified"
                  }
                ],
                "destination": "Maui, Hawaii",
                "id": "rec-1",
                "matchedExperiences": [
                  "beach"
                ],
                "summary": "Warm beaches and calm snorkeling water in February."
              }
            ]
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.critique.pass": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.critique.unresolved": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 0
                }
              ]
            },
            "$.critique.unresolved[*].issue": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.critique.unresolved[*].recommendationId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.recommendations": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.recommendations[*].claims": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.recommendations[*].claims[*].kind": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^(flight|lodging|price|activity|other)$"
                }
              ]
            },
            "$.recommendations[*].claims[*].statement": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.recommendations[*].claims[*].verification": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^(unverified|fixture)$"
                }
              ]
            },
            "$.recommendations[*].destination": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.recommendations[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.recommendations[*].matchedExperiences": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.recommendations[*].matchedExperiences[*]": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^(beach|pool|golf|go-karts|hiking|snorkeling|theme-parks|museums|nightlife|skiing)$"
                }
              ]
            },
            "$.recommendations[*].summary": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^application\\/json(;.*)?$"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
