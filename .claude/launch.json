{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/web-nextjs/node_modules/next/dist/bin/next",
        "dev",
        "apps/web-nextjs",
        "--port",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "backends/api-nextjs/node_modules/next/dist/bin/next",
        "dev",
        "backends/api-nextjs",
        "--hostname",
        "127.0.0.1",
        "--port",
        "4000"
      ],
      "port": 4000
    }
  ]
}
