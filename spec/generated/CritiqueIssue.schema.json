{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CritiqueIssue.schema.json",
  "type": "object",
  "properties": {
    "recommendationId": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "issue": {
      "type": "string",
      "maxLength": 300
    }
  },
  "required": [
    "recommendationId",
    "issue"
  ]
}
