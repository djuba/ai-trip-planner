{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Traveler.schema.json",
  "type": "object",
  "properties": {
    "userType": {
      "$ref": "UserType.schema.json"
    },
    "age": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "gender": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "userType"
  ]
}
