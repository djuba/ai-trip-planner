{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "MessageCatalog.schema.json",
  "type": "object",
  "properties": {
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "violations": {
      "type": "object",
      "properties": {
        "CHILD_AGE_RANGE": {
          "type": "string",
          "minLength": 1
        },
        "ADULT_AGE_RANGE": {
          "type": "string",
          "minLength": 1
        },
        "DATE_ORDER": {
          "type": "string",
          "minLength": 1
        },
        "DATE_NOT_PAST": {
          "type": "string",
          "minLength": 1
        },
        "DATE_VALID": {
          "type": "string",
          "minLength": 1
        },
        "PARTY_HAS_ADULT": {
          "type": "string",
          "minLength": 1
        },
        "INSUFFICIENT_DETAIL": {
          "type": "string",
          "minLength": 1
        },
        "MAX_STOPS_RANGE": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "CHILD_AGE_RANGE",
        "ADULT_AGE_RANGE",
        "DATE_ORDER",
        "DATE_NOT_PAST",
        "DATE_VALID",
        "PARTY_HAS_ADULT",
        "INSUFFICIENT_DETAIL",
        "MAX_STOPS_RANGE"
      ]
