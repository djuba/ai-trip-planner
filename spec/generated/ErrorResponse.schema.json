{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ErrorResponse.schema.json",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "ErrorCode.schema.json"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    }
  },
  "required": [
    "error"
  ]
}
