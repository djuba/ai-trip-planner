{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Recommendation.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 100
    },
    "destination": {
      "type": "string",
      "maxLength": 100
    },
    "summary": {
      "type": "string",
      "maxLength": 500
    },
    "matchedExperiences": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "$ref": "Experience.schema.json"
      }
    },
    "claims": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "$ref": "FactualClaim.schema.json"
      }
    }
  },
  "required": [
    "id",
    "destination",
    "summary",
    "matchedExperiences",
    "claims"
  ]
}
