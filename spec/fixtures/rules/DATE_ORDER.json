  {
    "id": "order-end-before-start",
    "ac": "AC-RULES-09",
    "description": "fixed end before start fires DATE_ORDER at /dateRange",
    "referenceDate": "2027-03-01",
    "profile": {
      "region": "Italy",
      "climate": "warm",
      "experiences": ["beach"],
      "dateRange": {
