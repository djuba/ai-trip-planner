{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ExtractionSchema.schema.json",
  "type": "object",
  "properties": {
    "departure": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "city": {
              "type": [
                "string",
                "null"
              ]
            },
            "mode": {
              "anyOf": [
                {
                  "$ref": "TravelMode.schema.json"
                },
                {
                  "type": "null"
                }
              ]
            },
            "maxStops": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "city",
            "mode",
            "maxStops"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "dateRange": {
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "fixed"
                },
                "start": {
                  "type": "string"
                },
                "end": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "start",
                "end"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "flexible"
                },
                "month": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "year": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "durationNights": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "note": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "kind",
                "month",
                "year",
                "durationNights",
                "note"
              ]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "region": {
      "type": [
        "string",
        "null"
      ]
    },
    "climate": {
      "anyOf": [
        {
          "$ref": "Climate.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "experiences": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "Experience.schema.json"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "unmappedExperiences": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "people": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "userType": {
                "$ref": "UserType.schema.json"
              },
              "age": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "gender": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "userType",
              "age",
              "gender"
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "departure",
    "dateRange",
    "region",
    "climate",
    "experiences",
    "unmappedExperiences",
    "people"
  ]
}
