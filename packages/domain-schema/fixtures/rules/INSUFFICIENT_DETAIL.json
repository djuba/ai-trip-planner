  {
    "id": "detail-date-fixed-malformed",
    "ac": "AC-RULES-30",
    "description": "malformed fixed range still counts and fires DATE_VALID instead",
    "referenceDate": "2027-03-01",
    "profile": {
      "dateRange": {
        "kind": "fixed",
        "start": "2027-6-1",
        "end": "2027-6-2"
      },
      "climate": "warm",
      "experiences": ["beach"]
    },
    "expectedViolations": [
      {
        "code": "DATE_VALID",
        "path": "/dateRange/start",
        "params": {
          "value": "2027-6-1"
        }
      },
      {
        "code": "DATE_VALID",
        "path": "/dateRange/end",
        "params": {
          "value": "2027-6-2"
        }
      }
    ]
  },
